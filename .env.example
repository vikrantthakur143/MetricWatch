# Copy to .env and edit:  cp .env.example .env
#
# Configuration only -- NO SECRETS. Passwords live in secrets/<service>_<username>.
# See README.md for what any of this means in full.
#
# An inline comment needs a space before the '#' AND a value in front of it.
# Compose strips "9090  # note", keeps "9090# note" whole, and on an empty
# value keeps the comment itself as the value.

# ----------------------------------------------------------------- project
COMPOSE_PROJECT_NAME=metricwatch       # prefixes container, network and volume names

# ------------------------------------------------------------------ images
PROMETHEUS_VERSION=v3.1.0              # prom/prometheus tag
ALERTMANAGER_VERSION=v0.28.0           # prom/alertmanager tag
GRAFANA_VERSION=11.5.1                 # grafana/grafana tag
NODE_EXPORTER_VERSION=v1.9.1           # prom/node-exporter tag
BLACKBOX_VERSION=v0.26.0               # prom/blackbox-exporter tag
CURL_VERSION=8.11.1                    # curlimages/curl tag, used by dashboard-init
TOOLBOX_IMAGE=metricwatch/toolbox:1    # built from docker/toolbox: openssl + htpasswd

# --------------------------------------------------------- published ports
# Host side only; the containers keep their standard ports internally.
PROMETHEUS_PORT=9090                   # https://localhost:9090
ALERTMANAGER_PORT=9093                 # https://localhost:9093
GRAFANA_PORT=3000                      # https://localhost:3000

# ----------------------------------------------------------------- network
NETWORK_NAME=metricwatch               # dedicated bridge, not the compose default
NETWORK_SUBNET=172.28.0.0/16           # must not overlap another docker network

# ----------------------------------------------------------------- storage
# Where the Prometheus TSDB lives. Must be a local disk -- Docker Desktop
# cannot bind-mount a network share.
#
# Prometheus runs as uid 65534 and Docker creates a missing bind mount owned
# by root, so on Linux make the directory yourself first or Prometheus panics
# on start with "permission denied":
#
#   mkdir -p prometheus_data && sudo chown 65534:65534 prometheus_data
#
PROMETHEUS_DATA=./prometheus_data
PROMETHEUS_RETENTION_TIME=3650d        # 10 years; whichever limit is hit first wins
PROMETHEUS_RETENTION_SIZE=200GB        # the disk has to be able to hold this

# ---------------------------------------------------------------- accounts
# Which account each service uses. Its password is the file named after it,
# secrets/<service>_<username>, which bootstrap generates when missing.
# Adding a file adds an account; Grafana provisions only the one named here.
PROMETHEUS_WEB_USER=admin              # also the account config-reload logs in as
ALERTMANAGER_WEB_USER=admin            # also the account Prometheus notifies with
GRAFANA_ADMIN_USER=admin               # Grafana supports one provisioned admin

# --------------------------------------------------------------------- TLS
# Every service serves HTTPS from certs/<service>/<domain>/, always with
# certbot filenames. CERT_MODE only decides where those files come from, and
# switching modes needs no change to any service config.
CERT_MODE=self-signed                  # self-signed | certbot | provided
CERT_DOMAIN=localhost                  # cert CN, the directory name, and the host in each external URL
# Per-service overrides; leave empty to use CERT_DOMAIN. Do NOT put an inline
# comment after an empty value: Compose only strips one when a value comes
# first, and would otherwise hand the service the comment text as the domain.
CERT_DOMAIN_PROMETHEUS=
CERT_DOMAIN_ALERTMANAGER=
CERT_DOMAIN_GRAFANA=
CERT_DAYS=3650                         # self-signed lifetime, 10 years
CERT_WARN_DAYS=30                      # warn this long before expiry, every mode
CERTBOT_DIR=./certs                    # certbot mode: the root holding live/ and archive/, NOT live/

# -------------------------------------------------------------- dashboards
# grafana.com dashboards to provision: id, id:name, or id:name:revision. The
# list is the whole truth -- removing one deletes its JSON on the next run.
# Two of them may not share a TITLE, or Grafana stops updating the folder.
# name becomes the filename and may contain spaces, but then the whole value
# has to be quoted or `. ./.env` from a shell chokes on it.
GRAFANA_DASHBOARDS="15489:Prometheus 2.0 Stats,16420:Alerts,3590:Grafana Internals,1860:Node Exporter Full,20338:Blackbox exporter - ICMP"
GRAFANA_DATASOURCE=Prometheus          # ${DS_PROMETHEUS} placeholders bind to this
GRAFANA_DASHBOARDS_CUSTOM_DIR=grafana/dashboards-custom   # hand-written JSON, copied in as-is

# --------------------------------------------------------------- resources
# From measured peak usage, with 3-4x headroom. Raise one if a container is
# OOM-killed -- docker inspect <name> --format '{{.State.OOMKilled}}'.
# CPU is in cores: 0.50 means half a core.
PROMETHEUS_CPU_LIMIT=1.00              # rule evaluation is the spiky part
PROMETHEUS_MEM_LIMIT=512M              # grows with active series and retention
PROMETHEUS_CPU_RESERVE=0.10
PROMETHEUS_MEM_RESERVE=128M

ALERTMANAGER_CPU_LIMIT=0.25            # near-idle between alerts
ALERTMANAGER_MEM_LIMIT=128M
ALERTMANAGER_CPU_RESERVE=0.05
ALERTMANAGER_MEM_RESERVE=32M

GRAFANA_CPU_LIMIT=0.50                 # spikes while rendering a dashboard
GRAFANA_MEM_LIMIT=512M
GRAFANA_CPU_RESERVE=0.10
GRAFANA_MEM_RESERVE=128M

NODE_EXPORTER_CPU_LIMIT=0.25           # collectors run only while being scraped
NODE_EXPORTER_MEM_LIMIT=128M
NODE_EXPORTER_CPU_RESERVE=0.05
NODE_EXPORTER_MEM_RESERVE=32M

BLACKBOX_CPU_LIMIT=0.25                # grows with the number of probes
BLACKBOX_MEM_LIMIT=128M
BLACKBOX_CPU_RESERVE=0.05
BLACKBOX_MEM_RESERVE=32M

INIT_CPU_LIMIT=0.50                    # the one-shot init services, which run briefly and exit
INIT_MEM_LIMIT=128M
