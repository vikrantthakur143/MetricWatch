# Copies of old configs kept before a rewrite. Local scratch, never tracked.
backup/

# Local configuration. Start from the tracked example:
#   cp .env.example .env
.env

# Credentials, one folder per service, mounted read-only at /run/secrets.
# Also holds web.yml for Prometheus and Alertmanager, generated by
# scripts/bootstrap.sh and containing a bcrypt hash. Nothing here is tracked;
# see the Secrets section of README.md for what each file must contain.
secrets/

# TLS material, one folder per service in certbot's layout. Self-signed by
# scripts/bootstrap.sh when absent, or drop real certbot output in at the same
# paths. Contains private keys -- never tracked.
certs/

# The Prometheus TSDB, where PROMETHEUS_DATA in .env points by default. Tens
# of gigabytes of time series, and yours rather than the project's.
prometheus_data/

# The Prometheus configuration is yours: scrape jobs, the hosts you watch,
# the thresholds you alert on. Editing it should not show up in git status,
# and your hostnames should never reach a public repo by accident.
#
# What ships instead is prometheus/example/, a tracked copy of all three sets
# below. The config-init service copies it into place on a first run -- see
# scripts/init-config.sh -- so a clone still starts with a working Prometheus.
# The example/ paths are not matched by these patterns, which are anchored.
prometheus/prometheus.yml
prometheus/targets/*.yml
prometheus/rules/*.yml

# alertmanager.yml, blackbox/blackbox.yml and the Grafana provisioning under
# grafana/ are still TRACKED and ship ready to run, naming only the containers
# in docker-compose.yml and the accounts bootstrap creates.
#
# That makes them published files. Anything site-specific you add (a mail
# address, a smarthost, your own usernames) is a local edit that must not be
# committed. `git update-index --skip-worktree <file>` keeps such an edit out
# of `git status` if you would rather not see it.

# Grafana UI exports of the sensor dashboards. These are working files: they
# carry the URLs and datasource uid of the Grafana they came from, so they
# stay local. scripts/grafana_dashboard/adapt.py is tracked, and its output in
# grafana/dashboards-custom/ is what actually gets provisioned.
scripts/grafana_dashboard/*.json

# Hand-written dashboards, copied in as-is alongside the grafana.com
# downloads. Yours, like the Prometheus config above -- a dashboard you build
# is not something this repo should carry. scripts/fetch-dashboards.sh creates
# the directory when it is missing, so a clone has somewhere to put them.
grafana/dashboards-custom/

# Assembled by scripts/fetch-dashboards.sh from GRAFANA_DASHBOARDS in .env
# and grafana/dashboards-custom/. Regenerated on every `docker compose up`,
# so the contents are not tracked -- edit .env or the custom folder.
grafana/dashboards/
